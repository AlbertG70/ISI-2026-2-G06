{
  "appId": "com.isicorp.dagaz",
  "appName": "DAGAZ",
  "webDir": "../frontend/dist",
  "server": {
    "cleartext": true,
    "allowNavigation": [
      "192.168.*",
      "10.0.2.2",
      "localhost",
      "127.0.0.1",
      "*"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": true
  }
}
