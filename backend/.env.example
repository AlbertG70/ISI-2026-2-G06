APP_NAME=DAGAZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Red, Proxies Inversos, HTTPS y CORS (Producción PaaS) ──────────────────
# En Railway/Render configure APP_ENV=production, APP_DEBUG=false, APP_URL=https://tu-dominio
# y LOG_CHANNEL=stderr para ver logs directamente en el panel del contenedor.
TRUSTED_PROXIES=*
# APP_FORCE_HTTPS=true
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=3600

# ─── Base de Datos ────────────────────────────────────────────────────────────
# Opción A: PostgreSQL remoto (Neon)
DB_CONNECTION=pgsql
DB_URL="postgresql://USUARIO:CONTRASEÑA@HOST/BASE_DE_DATOS?sslmode=require"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=Raiden
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=require

# Opción B: MariaDB local (descomentar y comentar las líneas de pgsql)
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=raiden
# DB_USERNAME=root
# DB_PASSWORD=

# En contenedores efímeros (Railway/Render) se recomienda SESSION_DRIVER=database
# y CACHE_STORE=database para persistir estado entre reinicios de contenedor.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="dagaz@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── DAGAZ — Adaptadores de IA ───────────────────────────────────────────────
# Proveedores soportados: openai, openrouter, gemini, local
DAGAZ_IA_PROVEEDOR=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODELO=gpt-4o
OPENAI_MAX_TOKENS=2000
GEMINI_MODELO=gemini-2.0-flash
ANTHROPIC_MODELO=claude-3-5-sonnet-20241022
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# ─── DAGAZ — Consejo de Verificación Multi-Modelo (Harness) ───────────────────
# Activa la verificación concurrente con GPT-4o, Claude, Gemini, DeepSeek y Qwen
DAGAZ_MULTI_MODELO_HABILITADO=true
DAGAZ_MULTI_MODELO_TIMEOUT=20
DAGAZ_MULTI_MODELO_CALIBRAR=true
DAGAZ_COUNCIL_QWEN_ACTIVO=false

# ─── DAGAZ — Microservicios Python (OCR / STT) ──────────────────────────────
OCR_SERVICE_URL=http://localhost:5001/ocr
STT_SERVICE_URL=http://localhost:5002/stt

# ─── DAGAZ — Circuit Breaker ─────────────────────────────────────────────────
DAGAZ_MAX_TOKENS_POR_HORA=50000
DAGAZ_PRESUPUESTO_DIARIO_USD=5.00

VITE_APP_NAME="${APP_NAME}"
